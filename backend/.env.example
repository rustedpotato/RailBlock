# RailBlock AI — Backend Environment Configuration
PROJECT_NAME="RailBlock AI Backend"
ENVIRONMENT="development"
API_V1_STR="/api/v1"

# CORS configuration: JSON array of allowed origins
BACKEND_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:3000"]

# Database URL (SQLite for local development, PostgreSQL ready for production)
DATABASE_URL="sqlite:///./railblock.db"
# Example PostgreSQL URL:
# DATABASE_URL="postgresql+psycopg2://postgres:password@localhost:5432/railblock"

# Server configuration
HOST="0.0.0.0"
PORT=8000
RELOAD=true

# Gemini API key (https://aistudio.google.com/apikey) for weekly mega-block fetching
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-3.5-flash-lite"
